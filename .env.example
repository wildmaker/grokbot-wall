# Copy this file to .env and fill it in. Restart serve.mjs after editing.

# === One .env per event: change these, restart, and the same repo serves another meetup ===
# The Luma event this deployment serves. Paste the public link (or an evt-... id). It is resolved
# through Luma's public page API at startup - no API key or login needed for this part.
LUMA_EVENT_URL=
# Headline drifting across the wall (also used in the email). Leave empty to use the event's own
# Luma title, e.g. "Grok Bot Meetup Zhengzhou". The ?headline=... URL param overrides it per screen.
EVENT_NAME=
# Check-in polling always starts OFF; flip POLL on in the desk console (?desk, press D) at the
# venue. Set to 1 only if you want it to resume by itself after a restart.
LUMA_POLL_ON_START=0

# --- Luma official API (optional) ---  Luma -> Settings -> Developer -> API Keys.
# Without a key the wall relies on the browser-session poller below.
LUMA_API_KEY=
# Legacy alias of LUMA_EVENT_URL (an evt-... id); LUMA_EVENT_URL wins if both are set.
LUMA_EVENT_ID=

# Standalone browser-session poller helper (does not use LUMA_API_KEY). It reads the event from
# the wall (or LUMA_EVENT_URL above), and only makes requests while the desk-console POLL switch
# is on. Run `npm run checkins:login` once first.
LUMA_CHECKIN_POLL_ENABLED=0
LUMA_CHECKIN_POLL_MS=2000
LUMA_BROWSER_PROFILE_DIR=
LUMA_BROWSER_HEADLESS=0
LUMA_CHECKIN_NOTIFY_WALL=1
WALL_URL=http://127.0.0.1:8787

# --- Resend (optional): emails each guest their code the moment they check in ---
RESEND_API_KEY=
# Sender. The domain must be verified in Resend (Domains → Add). Without one, only
# onboarding@resend.dev works, and only to your own Resend account email.
EMAIL_FROM=Grok Bot <hello@yourdomain.com>
EMAIL_REPLY_TO=
EMAIL_SUBJECT=
EMAIL_EVENT_NAME=
# Rehearsal switches: EMAIL_DRY_RUN=1 logs instead of sending; EMAIL_TEST_TO=you@x.com
# redirects EVERY guest email to that address (subject shows the original recipient).
EMAIL_DRY_RUN=0
EMAIL_TEST_TO=
# EMAIL_OFF=1 disables sending entirely even if a key is present.
EMAIL_OFF=0

# --- hosting ---
PORT=8787
# Access token: everything except the Luma webhook and /assets requires it. Open the wall as /?key=<token>
WALL_TOKEN=
# Public base URL of this server (no trailing slash). When set, the server registers the Luma
# webhook (guest.updated) for <PUBLIC_URL>/webhooks/luma itself on startup.
PUBLIC_URL=
